#include <iostream>
#include <vector>
#include <string>
#include <chrono>
#include <iomanip>
#include <algorithm>

using namespace std;
using namespace std::chrono;

long long comps = 0;
long long swaps = 0;

// злиттям
void merge(vector<int>& a, int l, int m, int r) {
    vector<int> left(a.begin() + l, a.begin() + m + 1);
    vector<int> right(a.begin() + m + 1, a.begin() + r + 1);

    int i = 0, j = 0, k = l;
    while (i < left.size() && j < right.size()) {
        comps++; swaps++;
        if (left[i] <= right[j]) a[k++] = left[i++];
        else a[k++] = right[j++];
    }
    while (i < left.size()) { a[k++] = left[i++]; swaps++; }
    while (j < right.size()) { a[k++] = right[j++]; swaps++; }
}

void mergeSort(vector<int>& a, int l, int r) {
    if (l >= r) return;
    int m = l + (r - l) / 2;
    mergeSort(a, l, m);
    mergeSort(a, m + 1, r);
    merge(a, l, m, r);
}

// вставками
void insertionSort(vector<int>& a) {
    for (int i = 1; i < a.size(); i++) {
        int key = a[i];
        int j = i - 1;
        while (j >= 0 && (++comps && a[j] > key)) {
            a[j + 1] = a[j];
            swaps++;
            j--;
        }
        a[j + 1] = key;
        swaps++;
    }
}

// пірамідальне
void heapify(vector<int>& a, int n, int i) {
    int largest = i, l = 2 * i + 1, r = 2 * i + 2;
    if (l < n && (++comps && a[l] > a[largest])) largest = l;
    if (r < n && (++comps && a[r] > a[largest])) largest = r;
    if (largest != i) {
        swap(a[i], a[largest]);
        swaps++;
        heapify(a, n, largest);
    }
}

void heapSort(vector<int>& a) {
    int n = a.size();
    for (int i = n / 2 - 1; i >= 0; i--) heapify(a, n, i);
    for (int i = n - 1; i > 0; i--) {
        swap(a[0], a[i]);
        swaps++;
        heapify(a, i, 0);
    }
}

vector<int> generateArray(int n, string type) {
    vector<int> a(n);
    for (int i = 0; i < n; i++) a[i] = rand() % 10000;

    if (type == "Sorted") sort(a.begin(), a.end());
    if (type == "Reversed") { sort(a.begin(), a.end()); reverse(a.begin(), a.end()); }
    return a;
}

void test(string name, int alg, int size, string type) {
    vector<int> a = generateArray(size, type);
    comps = 0; swaps = 0;

    auto start = high_resolution_clock::now();
    if (alg == 1) mergeSort(a, 0, a.size() - 1);
    else if (alg == 2) insertionSort(a);
    else if (alg == 3) heapSort(a);
    auto stop = high_resolution_clock::now();

    double time = duration<double, milli>(stop - start).count();

 
    cout << "| " << left << setw(18) << name
        << " | " << setw(6) << size
        << " | " << setw(10) << type
        << " | " << right << setw(10) << fixed << setprecision(3) << time
        << " | " << setw(12) << comps
        << " | " << setw(12) << swaps << " |\n";
}

int main() {
    int sizes[] = { 100, 1000, 10000 };
    string types[] = { "Random", "Sorted", "Reversed" };

    string line = "+" + string(20, '-') + "+" + string(8, '-') + "+" + string(12, '-') + "+" + string(12, '-') + "+" + string(14, '-') + "+" + string(14, '-') + "+";

    cout << line << "\n";
    cout << "| " << left << setw(18) << "Algorithm"
        << " | " << setw(6) << "Size"
        << " | " << setw(10) << "Type"
        << " | " << setw(10) << "Time (ms)"
        << " | " << setw(12) << "Comparisons"
        << " | " << setw(12) << "Swaps" << " |\n";
    cout << line << "\n";

    for (int n : sizes) {
        for (string type : types) {
            test("Merge Sort", 1, n, type);
            test("Insertion Sort", 2, n, type);
            test("Heap Sort", 3, n, type);
            cout << line << "\n";
        }
    }
    return 0;
}
